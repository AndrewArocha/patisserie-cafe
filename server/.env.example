NODE_ENV=development
PORT=3000
CLIENT_ORIGIN=http://localhost:3001
MONGODB_URI=mongodb://127.0.0.1:27017/patisserie-cafe
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=2h
PASSWORD_MIN_LENGTH=10
CHECKOUT_PROVIDER=stripe
STRIPE_SECRET_KEY=
STRIPE_SUCCESS_URL=http://localhost:3001/order?checkout=success
STRIPE_CANCEL_URL=http://localhost:3001/order?checkout=cancel
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=contact@patisseriecafe.co
CATERING_REQUEST_EMAIL=catering@patisseriecafe.co
# For Cloudflare Email Sending over HTTPS, set both credentials and a sender on an onboarded domain.
# CLOUDFLARE_EMAIL_ACCOUNT_ID=
# CLOUDFLARE_EMAIL_API_TOKEN=
# CLOUDFLARE_EMAIL_FROM=
